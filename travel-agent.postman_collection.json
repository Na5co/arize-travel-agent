                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Any flights from London to Proto on 2027-08-12?\"\n}"
            },
            "url": "{{base_url}}/chat",
            "description": "Starts a new conversation. Expect: asks which city you mean instead of guessing (no tool call)."
          }
        },
        {
          "name": "Typo city: confirm Porto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
