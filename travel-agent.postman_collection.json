    },
    {
      "name": "4. API checks",
      "description": "The API itself, not the agent.",
      "item": [
        {
          "name": "Unknown session_id is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 for a session the server never issued', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello\",\n  \"session_id\": \"made-up-session\"\n}"
            },
            "url": "{{base_url}}/chat",
            "description": "Expect: 404. Session IDs are issued by the server, so clients can't pick guessable IDs."
          }
        }
      ]
    }
  ]
}