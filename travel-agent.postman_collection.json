            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Yes, I meant Porto.\",\n  \"session_id\": \"{{session_id}}\"\n}"
            },
            "url": "{{base_url}}/chat",
            "description": "Same conversation. Expect: searches London → Porto."
          }
        },
