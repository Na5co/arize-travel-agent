              "mode": "raw",
              "raw": "{\n  \"message\": \"Any flights from London to Tokio on 2027-04-02?\"\n}"
            },
            "url": "{{base_url}}/chat",
            "description": "Starts a new conversation. Expect: searches Tokyo (HND/NRT): 'Tokio' is a common spelling in other languages."
          }
        },
